<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>StreamToM3U.ArchitectureTests</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ExcludeFromCodeCoverage>true</ExcludeFromCodeCoverage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="5.0.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.5" />
    <PackageReference Include="TngTech.ArchUnitNET.NUnit" Version="0.13.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../StreamToM3U/StreamToM3U.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ArchitectureSource Include="../StreamToM3U/**/*.cs" Exclude="../StreamToM3U/bin/**;../StreamToM3U/obj/**">
      <ArchitectureSourceProject>StreamToM3U</ArchitectureSourceProject>
    </ArchitectureSource>
    <ArchitectureSource Include="../StreamToM3U.UnitTests/**/*.cs" Exclude="../StreamToM3U.UnitTests/bin/**;../StreamToM3U.UnitTests/obj/**">
      <ArchitectureSourceProject>StreamToM3U.UnitTests</ArchitectureSourceProject>
    </ArchitectureSource>
  </ItemGroup>

  <ItemGroup>
    <ArchitectureProjectFile Include="../StreamToM3U/StreamToM3U.csproj">
      <ArchitectureProjectName>StreamToM3U</ArchitectureProjectName>
    </ArchitectureProjectFile>
    <ArchitectureProjectFile Include="../StreamToM3U.UnitTests/StreamToM3U.UnitTests.csproj">
      <ArchitectureProjectName>StreamToM3U.UnitTests</ArchitectureProjectName>
    </ArchitectureProjectFile>
    <ArchitectureProjectFile Include="StreamToM3U.ArchitectureTests.csproj">
      <ArchitectureProjectName>StreamToM3U.ArchitectureTests</ArchitectureProjectName>
    </ArchitectureProjectFile>
    <ArchitectureSolutionFile Include="../StreamToM3U.slnx" />
  </ItemGroup>

  <Target Name="CopyArchitectureSources" AfterTargets="Build">
    <PropertyGroup>
      <ArchitectureSourcesDirectory>$(TargetDir)ArchitectureSources</ArchitectureSourcesDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(ArchitectureSourcesDirectory)" />
    <Copy SourceFiles="@(ArchitectureSource)" DestinationFiles="@(ArchitectureSource->'$(ArchitectureSourcesDirectory)/Sources/%(ArchitectureSourceProject)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ArchitectureProjectFile)" DestinationFiles="@(ArchitectureProjectFile->'$(ArchitectureSourcesDirectory)/Projects/%(ArchitectureProjectName).csproj')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(ArchitectureSolutionFile)" DestinationFiles="@(ArchitectureSolutionFile->'$(ArchitectureSourcesDirectory)/Projects/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>